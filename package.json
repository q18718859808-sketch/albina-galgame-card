{
  "name": "albina-galgame-card-source",
  "version": "2.0.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:generate": "node scripts/audit-assets.mjs --write",
    "assets:audit": "node scripts/audit-assets.mjs",
    "media:readiness": "node scripts/audit-media-readiness.mjs",
    "media:readiness:strict": "node scripts/audit-media-readiness.mjs --strict",
    "visual:plan": "node scripts/plan-visual-rebuild.mjs",
    "visual:produce:x666": "node scripts/produce-visual-images.mjs",
    "visual:review": "node scripts/review-visual-images.mjs",
    "visual:promote": "node scripts/promote-visual-images.mjs",
    "visual:video:produce": "node scripts/produce-visual-videos.mjs",
    "visual:video:review": "node scripts/review-visual-videos.mjs",
    "visual:video:promote": "node scripts/promote-visual-videos.mjs",
    "build": "vite build",
    "canon:sync": "node scripts/sync-canon-card.mjs --write",
    "canon:check": "node scripts/sync-canon-card.mjs",
    "canon-visual:index": "node scripts/index-canon-visual-sources.mjs",
    "card:sync": "node scripts/sync-character-card-png.mjs --write",
    "card:check": "node scripts/sync-character-card-png.mjs",
    "story:compile": "vite-node scripts/compile-story.mjs",
    "voice:produce-boundary": "node scripts/produce-boundary-voice.mjs",
    "voice:promote-legacy": "node scripts/promote-legacy-voice.mjs",
    "release:status": "node scripts/release-status.mjs --print",
    "release:status:write": "node scripts/release-status.mjs --write",
    "release:status:check": "node scripts/release-status.mjs",
    "release:gate:rc": "node scripts/release-push.mjs --channel rc",
    "release:gate:final": "node scripts/release-push.mjs --channel final",
    "release:push:rc": "node scripts/release-push.mjs --channel rc --execute",
    "release:push:final": "node scripts/release-push.mjs --channel final --execute",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "security:scan": "node scripts/security-scan.mjs",
    "verify": "npm run release:sync && npm run release:status:check && npm run canon:check && npm run card:check && npm run typecheck && npm test && npm run build && npm run security:scan && npm run media:readiness:strict && npm run test:e2e && node scripts/verify-release.mjs",
    "release:sync": "node scripts/release-sync.mjs"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.10",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.1"
  }
}
