{
  "name": "albina-galgame-card-source",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:generate": "node scripts/audit-assets.mjs --write",
    "assets:audit": "node scripts/audit-assets.mjs",
    "build": "vite build",
    "card:sync": "node scripts/sync-character-card-png.mjs --write",
    "card:check": "node scripts/sync-character-card-png.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "security:scan": "node scripts/security-scan.mjs",
    "verify": "npm run card:check && npm run typecheck && npm test && npm run release:sync && npm run security:scan",
    "release:sync": "node scripts/release-sync.mjs"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.10",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.1"
  }
}
